<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jakecp.golf-booking</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/golfbot/golf-booker/mac-mini-run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/golfbot/golf-booker</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/golfbot</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Background</string>
        <string>Aqua</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/golfbot/golf-booker/logs/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/golfbot/golf-booker/logs/launchd.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
